  // ============================================================= LEGEND
  subgraph cluster_legend {
    label=""; style="invis"; margin=6;
    lg_note [shape=note, style=filled, fillcolor="#FFFDF2", color="#D9B168", fontsize=9, fontname="Helvetica", label=<
      <B>Notation</B><BR ALIGN="LEFT"/>
      Rectangle = entity &#8226; double rectangle = associative/weak entity<BR ALIGN="LEFT"/>
      Ellipse = attribute &#8226; <U>underlined</U> = key &#8226; <I>dashed italic</I> = key inherited via ISA<BR ALIGN="LEFT"/>
      Diamond = relationship &#8226; triangle "d" = disjoint, total ISA specialization<BR ALIGN="LEFT"/>
      Thick edge = total (mandatory) &#8226; thin edge = partial (optional) participation<BR ALIGN="LEFT"/>
      FK columns are not drawn as attributes — the relationship edge is the reference<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      <FONT POINT-SIZE="7.5" COLOR="#888888">Full list of corrections &amp; reasoning: notehub_erd_explained.md</FONT><BR ALIGN="LEFT"/>
    >];
  }
