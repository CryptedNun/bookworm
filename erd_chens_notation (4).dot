  subgraph cluster_area5 {
    style=invis; margin=6;
    CO [shape=box, style="filled,rounded", peripheries=1, fillcolor="#FBD2D2", color="#B03A2E", penwidth=1.8, fontname="Helvetica-Bold", fontsize=12, margin=0.15, label="COMMITS"];
    MF [shape=box, style="filled,rounded", peripheries=2, fillcolor="#FBD2D2", color="#B03A2E", penwidth=1.8, fontname="Helvetica-Bold", fontsize=12, margin=0.15, label="COMMIT_\nMANIFESTS"];
